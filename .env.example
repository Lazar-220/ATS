# Copy to .env and fill in; .env is never committed.
# Each phase that introduces a variable adds it here and to docs/SETUP.md section 4.

# Postgres container (compose.yaml). Change POSTGRES_PORT if 5432 is taken on the host,
# and change the port in DATABASE_URL to match.
POSTGRES_PORT=5432
POSTGRES_USER=ats
POSTGRES_PASSWORD=ats
POSTGRES_DB=ats

DATABASE_URL=postgresql://ats:ats@localhost:5432/ats

# Worker and job queue
QUEUE_VISIBILITY_TIMEOUT_S=300
WORKER_POLL_INTERVAL_S=1.0

# PDFs averaging fewer non-space characters per page than this are rejected as scans
MIN_CHARS_PER_PAGE=100

# Uploaded PDFs, stored by sha256; relative paths start at the repository root
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=10

# LLM (Gemini). Only synthetic CVs on the free tier: Google may read what it receives (§6.1).
# Never set to fake outside a demo: "fake" calls no model and answers with canned keyword matches,
# so the interface can be tried with no key. The worker logs it loudly at startup.
LLM_PROVIDER=gemini
LLM_API_KEY=
# The v1 gate baseline model (docs/PROGRESS.md, 2026-11-25).
LLM_MODEL=gemini-3.5-flash-lite
# Free tier for gemini-3.5-flash-lite: 15 requests per minute, 500 per day; 14 leaves a margin.
LLM_RPM=14
LLM_CACHE_DIR=data/llm_cache

# A judge quote passes the quote check at this fuzzy score (0-100) or above.
QUOTE_FUZZY_THRESHOLD=90

# Eval runs only: after a Gemini daily quota, continue on an OpenRouter free model. Opt in with
# LLM_FALLBACK=openrouter (or `make eval FALLBACK=openrouter`) and a key. The API and the worker
# never use it. At most 50 calls a day; results are labelled dev-smoke, non-baseline.
LLM_FALLBACK=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Shown in the worker's startup line. Needed only where there is no .git (a Docker image).
# GIT_COMMIT=

# Vite dev server: where /api/* is forwarded (use http://api:8000 inside Compose)
API_PROXY_TARGET=http://localhost:8000

# Langfuse tracing (phase 1.6). Off unless LANGFUSE_ENABLED=true; nothing needs Langfuse running.
# `make langfuse-up` starts the local stack (compose.langfuse.yaml) with these placeholder keys,
# which belong to that local stack only. Never put a hosted Langfuse key here (traces hold prompts).
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-ats-local
LANGFUSE_SECRET_KEY=sk-lf-ats-local
