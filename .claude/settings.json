{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git init *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git merge *)",
      "Bash(git tag *)",
      "Bash(git stash *)",
      "Bash(uv sync *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv lock *)",
      "Bash(uv run *)",
      "Bash(uv python *)",
      "Bash(uv --version)",
      "Bash(make *)",
      "Bash(npm *)",
      "Bash(node --version)",
      "Bash(docker compose *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(docker stats *)",
      "Bash(docker images *)",
      "Bash(docker inspect *)",
      "Bash(docker pull *)",
      "Bash(docker exec *)",
      "Bash(docker volume ls *)",
      "Bash(docker network ls *)",
      "Bash(docker version *)",
      "Read(~/.cache/huggingface/**)",
      "WebSearch",
      "WebFetch(domain:ai.google.dev)",
      "WebFetch(domain:docs.astral.sh)",
      "WebFetch(domain:fastapi.tiangolo.com)",
      "WebFetch(domain:www.postgresql.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:huggingface.co)",
      "WebFetch(domain:pymupdf.readthedocs.io)",
      "WebFetch(domain:langfuse.com)",
      "WebFetch(domain:docs.langchain.com)",
      "WebFetch(domain:reference.langchain.com)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:docs.n8n.io)",
      "WebFetch(domain:code.claude.com)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down --volumes*)",
      "Bash(docker volume rm *)",
      "Bash(docker system prune *)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./data/real/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_python.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "uv run --quiet --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_commit_gate.py\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
